cabal-version:      3.0
name:               sool-ratt
version:            0.1.0.0
-- synopsis:
-- description:
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             SooL
maintainer:         soms@itu.dk loua@itu.dk
-- copyright:
category:           Type Checker
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Context
                    , Demo
                    , ErrorTypes
                    , SignalCombinators
                    , Syntax
                    , TypeChecker
    build-depends:    base >=4.7 && <5,
                      array
    hs-source-dirs:   src
    default-language: Haskell2010

executable sool-ratt
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base >=4.7 && <5,
                      sool-ratt
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite tc-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    TypeCheckerSpec
                    , ContextSpec
                    , SignalCombinatorsSpec
    build-depends:    base >=4.7 && <5,
                      hspec,
                      sool-ratt
    hs-source-dirs:   test
    default-language: Haskell2010